				"talk_one_new_name": "Something New?",
				"talk_one_new": [["And now it's new!!","And the text was yellow!!!"]],
				"talk_one_new2": [["It's new. It goes on more."]],
				"talk_one_new3": [["BUT WAIT! THERE'S MORE!!!!!"]],
				"talk_one_new_new_name": "MORE????",
				"talk_one_new_new": [["dats right baeby.","moer."]],
				"talk_one_new_new2": [["da moer...","it neva edns......"]],
				"talk_one_fin": [["nah, i was just messin with ya.","it ova now."]],
				"talk_two": [["You want to know what to do#here in Snowdin?"],["&sf:4&Grillby's has food, and the#library has information..."],["If you're tired, you can take#a nap at the inn.","It's right next door - my sister#runs it."],["&sf:n&And if you're bored, you can#sit outside and watch those wacky#skeleton brothers do their thing."],["There's two of 'em...","&sf:4&Brothers, I think.","They just showed up one day and...","&sf:n&... asserted themselves."],["The town has gotten a lot#more interesting since then."]],
				"talk_three": [["&sf:4&Think back to your history#class..."],["&sf:n&A long time ago, monsters lived#in the RUINS back there in#the forest."],["Long story short, we all decided#to leave the ruins and head#for the end of the caverns."],["Along the way, some fuzzy folk#decided they liked the cold#and set up camp in Snowdin."],["&sf:6&Oh, and don't think about#trying to explore the RUINS..."],["&sf:n&The door's been locked for ages.","So unless you're a ghost#or can burrow under the door,#forget about it."]],
				"talk_four": [["Life is the same as usual."],["&sf:1&A little claustrophobic..."],["&sf:2&But... we all know deep down#that freedom is coming,#don't we?"],["As long as we got that hope, we#can grit our teeth and face the#same struggles, day after day..."],["&sf:5&That's life, ain't it?"]],
				"refuse_buy": [["&sf:0&Huh?","Sell somethin'?","Does this look like a#pawn shop?"],["&sf:4&I don't know how it works where#you come from... but..."],["&sf:n&If I started spending money#on old branches and used#bandages, I'd be out of business#in a jiffy!"]],
				"refuse_buy2": [["&sf:4&If you're really hurtin' for#cash, then maybe you could#do some crowdfunding."],["I hear people will pay for#ANYTHING nowadays."]],
